# Copy this file to "secrets.yaml" (same folder) and fill in your own values.
# secrets.yaml must NOT be committed to Git (it is already listed in .gitignore).

wifi_ssid: "YourWiFiNetworkName"
wifi_password: "your-wifi-password"
ap_password: "fallback-ap-password"

# Generate a new key (32 bytes, base64) with:
#   esphome secrets smart-water-monitor.yaml
# or with: openssl rand -base64 32
api_encryption_key: "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="

ota_password: "your-ota-password"
